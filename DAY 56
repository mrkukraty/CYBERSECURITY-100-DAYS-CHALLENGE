# 21. SAFE MINI RED-TEAM HELPER

The following example combines:

- Scope validation
- DNS lookup
- HTTP information
- Limited port checks
- Logging
- JSON reporting

```python
import argparse
import json
import logging
import socket
from datetime import datetime, timezone

import requests


ALLOWED_TARGETS = {
    "lab.example",
    "192.168.56.101"
}

PORTS = [22, 80, 443, 445, 3389]


logging.basicConfig(
    filename="assessment.log",
    level=logging.INFO,
    format="%(asctime)s %(levelname)s %(message)s"
)


def check_scope(target):
    if target not in ALLOWED_TARGETS:
        raise ValueError(
            f"Target {target!r} is outside the authorized scope."
        )


def resolve_target(target):
    try:
        return socket.gethostbyname(target)
    except socket.gaierror:
        return None


def check_port(host, port):
    sock = socket.socket()
    sock.settimeout(2)

    try:
        return sock.connect_ex((host, port)) == 0
    except OSError:
        return False
    finally:
        sock.close()


def collect_http(target):
    for scheme in ("https", "http"):
        url = f"{scheme}://{target}"

        try:
            response = requests.get(
                url,
                timeout=10,
                allow_redirects=True
            )

            return {
                "url": response.url,
                "status": response.status_code,
                "server": response.headers.get("Server"),
                "content_type": response.headers.get("Content-Type")
            }

        except requests.RequestException:
            continue

    return None


def main():
    parser = argparse.ArgumentParser(
        description="Authorized red-team assessment helper"
    )

    parser.add_argument("target")
    parser.add_argument(
        "--output",
        default="assessment.json"
    )

    args = parser.parse_args()

    check_scope(args.target)

    logging.info("Assessment started for %s", args.target)

    ip = resolve_target(args.target)

    result = {
        "target": args.target,
        "timestamp": datetime.now(
            timezone.utc
        ).isoformat(),
        "resolved_ip": ip,
        "ports": {},
        "http": None
    }

    if ip:
        for port in PORTS:
            result["ports"][str(port)] = check_port(
                ip,
                port
            )

    result["http"] = collect_http(args.target)

    with open(args.output, "w", encoding="utf-8") as f:
        json.dump(result, f, indent=2)

    logging.info("Assessment completed")


if __name__ == "__main__":
    main()
```

