# 13. Python Project

Create:

```text
malware_detector.py
```

Use this defensive static scanner:

```python
import hashlib
import re
import sys
from pathlib import Path


# Suspicious indicators for educational analysis.
# These are NOT proof that a file is malicious.
INDICATORS = {
    "powershell": 2,
    "cmd.exe": 2,
    "wscript": 2,
    "cscript": 2,
    "rundll32": 2,
    "regsvr32": 2,
    "schtasks": 2,
    "download": 2,
    "http://": 1,
    "https://": 1,
    "encoded": 1,
}


def calculate_sha256(file_path):
    """Calculate SHA-256 without executing the file."""
    sha256 = hashlib.sha256()

    with open(file_path, "rb") as file:
        for chunk in iter(lambda: file.read(1024 * 1024), b""):
            sha256.update(chunk)

    return sha256.hexdigest()


def extract_text(file_path):
    """
    Extract printable ASCII strings from a file.

    This only reads the file.
    It does NOT execute it.
    """
    data = Path(file_path).read_bytes()

    strings = re.findall(rb"[ -~]{4,}", data)

    return [
        item.decode("ascii", errors="ignore").lower()
        for item in strings
    ]


def scan_file(file_path):
    print("=" * 60)
    print("BASIC MALWARE INDICATOR SCANNER")
    print("=" * 60)

    path = Path(file_path)

    if not path.exists():
        print("[ERROR] File does not exist.")
        return

    if not path.is_file():
        print("[ERROR] Path is not a file.")
        return

    print(f"\nFile: {path.name}")
    print(f"Size: {path.stat().st_size:,} bytes")

    # Hash
    try:
        file_hash = calculate_sha256(path)
        print(f"SHA-256: {file_hash}")
    except Exception as error:
        print(f"[ERROR] Hash calculation failed: {error}")
        return

    # Extract strings
    try:
        strings = extract_text(path)
    except Exception as error:
        print(f"[ERROR] Could not read file: {error}")
        return

    print(f"\nExtracted strings: {len(strings)}")

    # Search indicators
    findings = []
    total_score = 0

    for indicator, score in INDICATORS.items():
        matches = []

        for string in strings:
            if indicator in string:
                matches.append(string[:150])

        if matches:
            findings.append((indicator, score, matches))
            total_score += score

    # Risk level
    if total_score >= 6:
        risk = "HIGH"
    elif total_score >= 3:
        risk = "MEDIUM"
    else:
        risk = "LOW"

    print("\n--- INDICATORS ---")

    if not findings:
        print("No configured indicators were found.")
    else:
        for indicator, score, matches in findings:
            print(f"\n[+] {indicator}")
            print(f"    Score: +{score}")

            for match in matches[:3]:
                print(f"    Evidence: {match}")

    print("\n--- RESULT ---")
    print(f"Risk Score : {total_score}")
    print(f"Risk Level : {risk}")

    print("\nWARNING:")
    print("This is a basic heuristic scanner.")
    print("A HIGH score does NOT prove that the file is malware.")
    print("A LOW score does NOT prove that the file is safe.")


def main():
    if len(sys.argv) != 2:
        print("Usage:")
        print("python malware_detector.py <file>")
        return

    scan_file(sys.argv[1])


if __name__ == "__main__":
    main()
```

