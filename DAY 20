# 21. Complete Educational Scanner

```python
import socket
import json
import argparse
from datetime import datetime
from pathlib import Path


COMMON_PORTS = {
    21: "FTP",
    22: "SSH",
    23: "Telnet",
    25: "SMTP",
    53: "DNS",
    80: "HTTP",
    110: "POP3",
    139: "NetBIOS",
    143: "IMAP",
    443: "HTTPS",
    445: "SMB",
    3306: "MySQL",
    3389: "RDP",
    5432: "PostgreSQL",
    8080: "HTTP-ALT"
}


SECURITY_RULES = {
    23: {
        "service": "Telnet",
        "severity": "High",
        "finding":
            "Telnet detected; communication is not protected "
            "by modern encryption."
    },

    21: {
        "service": "FTP",
        "severity": "Medium",
        "finding":
            "FTP detected; evaluate whether encrypted "
            "file transfer is required."
    }
}


def check_port(target, port, timeout=1):
    sock = socket.socket(
        socket.AF_INET,
        socket.SOCK_STREAM
    )

    sock.settimeout(timeout)

    try:
        result = sock.connect_ex(
            (target, port)
        )

        return result == 0

    except socket.error:
        return False

    finally:
        sock.close()


def analyze_port(port):

    if port in SECURITY_RULES:
        rule = SECURITY_RULES[port]

        return {
            "finding": rule["finding"],
            "severity": rule["severity"]
        }

    return None


def scan_target(target):

    results = []

    for port, service in COMMON_PORTS.items():

        is_open = check_port(
            target,
            port
        )

        result = {
            "port": port,
            "service": service,
            "state":
                "open" if is_open else "closed"
        }

        if is_open:

            finding = analyze_port(port)

            if finding:
                result["finding"] = \
                    finding["finding"]

                result["severity"] = \
                    finding["severity"]

        results.append(result)

    return results


def save_report(
    target,
    results,
    filename
):

    report = {
        "target": target,
        "timestamp":
            datetime.now().isoformat(),
        "results": results
    }

    Path(filename).write_text(
        json.dumps(
            report,
            indent=4
        ),
        encoding="utf-8"
    )


def main():

    parser = argparse.ArgumentParser(
        description=
            "Educational Vulnerability Scanner"
    )

    parser.add_argument(
        "target",
        help=
            "Authorized target IP or hostname"
    )

    parser.add_argument(
        "--output",
        default="scan_report.json",
        help=
            "Output JSON report"
    )

    args = parser.parse_args()

    print(
        f"[+] Scanning authorized target: "
        f"{args.target}"
    )

    results = scan_target(
        args.target
    )

    save_report(
        args.target,
        results,
        args.output
    )

    print(
        f"[+] Report saved to: "
        f"{args.output}"
    )


if __name__ == "__main__":
    main()
```

