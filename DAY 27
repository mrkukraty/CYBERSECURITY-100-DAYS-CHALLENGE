# 35. COMPLETE EDUCATIONAL WEB SCANNER

Below is a **safe baseline scanner** intended for systems you own or are explicitly authorized to test.

```python
import argparse
import json
from datetime import datetime
from urllib.parse import urlparse, urljoin

import requests
from bs4 import BeautifulSoup


SECURITY_HEADERS = {
    "Content-Security-Policy": "CSP",
    "Strict-Transport-Security": "HSTS",
    "X-Content-Type-Options": "X-Content-Type-Options",
    "Referrer-Policy": "Referrer-Policy",
    "Permissions-Policy": "Permissions-Policy",
}


def add_finding(findings, title, severity, evidence, recommendation):
    findings.append({
        "title": title,
        "severity": severity,
        "evidence": evidence,
        "recommendation": recommendation,
    })


def scan(url):
    findings = []

    parsed = urlparse(url)

    if parsed.scheme not in {"http", "https"}:
        raise ValueError("Only HTTP/HTTPS URLs are supported")

    response = requests.get(
        url,
        timeout=10,
        allow_redirects=True,
        headers={
            "User-Agent": "Educational-Web-Scanner/1.0"
        },
    )

    soup = BeautifulSoup(response.text, "html.parser")

    result = {
        "target": url,
        "final_url": response.url,
        "timestamp": datetime.utcnow().isoformat() + "Z",
        "status_code": response.status_code,
        "content_type": response.headers.get("Content-Type"),
        "server": response.headers.get("Server"),
        "title": soup.title.get_text(strip=True)
                 if soup.title else "",
        "links": [],
        "forms": [],
        "findings": findings,
    }

    # HTTPS check
    final_scheme = urlparse(response.url).scheme

    if final_scheme != "https":
        add_finding(
            findings,
            "Target is not using HTTPS",
            "Medium",
            f"Final URL: {response.url}",
            "Use HTTPS for sensitive applications and review TLS configuration."
        )

    # Security headers
    for header, name in SECURITY_HEADERS.items():
        if header not in response.headers:
            add_finding(
                findings,
                f"Missing {name} header",
                "Low",
                f"{header} was not present",
                f"Review whether an appropriate {header} policy should be deployed."
            )

    # Links
    for link in soup.find_all("a", href=True):
        absolute = urljoin(response.url, link["href"])

        if urlparse(absolute).netloc == urlparse(response.url).netloc:
            result["links"].append(absolute)

    # Forms
    for form in soup.find_all("form"):
        method = form.get("method", "GET").upper()
        action = urljoin(response.url, form.get("action", ""))

        result["forms"].append({
            "method": method,
            "action": action,
        })

        if method in {"POST", "PUT", "PATCH", "DELETE"}:
            add_finding(
                findings,
                "State-changing form requires CSRF review",
                "Informational",
                f"{method} {action}",
                "Verify server-side CSRF protection, SameSite policy, and origin validation."
            )

    # Directory listing indicator
    if "Index of /" in response.text:
        add_finding(
            findings,
            "Possible directory listing",
            "Medium",
            "Response contains an 'Index of /' indicator",
            "Disable directory listing where it is not required."
        )

    return result


def main():
    parser = argparse.ArgumentParser(
        description="Educational Web Security Scanner"
    )

    parser.add_argument("url", help="Authorized HTTP/HTTPS target")
    parser.add_argument(
        "--output",
        default="web_scan.json",
        help="JSON output file"
    )

    args = parser.parse_args()

    result = scan(args.url)

    with open(args.output, "w", encoding="utf-8") as f:
        json.dump(result, f, indent=2)

    print(f"Scan completed: {result['target']}")
    print(f"HTTP status: {result['status_code']}")
    print(f"Findings: {len(result['findings'])}")
    print(f"Report: {args.output}")


if __name__ == "__main__":
    main()
```

